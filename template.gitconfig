[delta "rose-pine"]
	dark = true
	file-style = "$main-foam" bold ul
	file-decoration-style = "$main-muted/20"
	commit-decoration-style = "$main-muted/20"
	hunk-header-decoration-style = "$main-text" box
	hunk-header-line-number-style = "$main-muted"
	hunk-header-style = line-number syntax bold
	line-numbers-left-style = "$main-muted"
	line-numbers-minus-style = "$main-love"
	line-numbers-plus-style = "$main-pine"
	line-numbers-right-style = "$main-iris"
	line-numbers-zero-style = "$main-muted"
	minus-emph-style = syntax bold "$main-love/50"
	minus-style = syntax "$main-love/10"
	plus-emph-style = syntax bold "$main-pine/50"
	plus-style = syntax "$main-pine/10"
	whitespace-error-style = "$main-iris/10"
[delta "rose-pine-moon"]
	dark = true
	file-style = "$moon-foam" bold ul
	file-decoration-style = "$moon-muted/20"
	commit-decoration-style = "$moon-muted/20"
	hunk-header-decoration-style = "$moon-text" box
	hunk-header-line-number-style = "$moon-muted"
	hunk-header-style = line-number syntax bold
	line-numbers-left-style = "$moon-muted"
	line-numbers-minus-style = "$moon-love" bold
	line-numbers-plus-style = "$moon-pine" bold
	line-numbers-right-style = "$moon-iris"
	line-numbers-zero-style = "$moon-muted"
	minus-emph-style = syntax bold "$moon-love/50"
	minus-style = syntax "$moon-love/10"
	plus-emph-style = syntax bold "$moon-pine/50"
	plus-style = syntax "$moon-pine/10"
	whitespace-error-style = "$moon-iris/10"
[delta "rose-pine-dawn"]
	light = true
	file-style = "$dawn-foam" bold ul
	file-decoration-style = "$dawn-muted/20"
	commit-decoration-style = "$dawn-muted/20"
	hunk-header-decoration-style = "$dawn-text" box
	hunk-header-line-number-style = "$dawn-muted"
	hunk-header-style = line-number syntax bold
	line-numbers-left-style = "$dawn-muted"
	line-numbers-minus-style = "$dawn-love" bold
	line-numbers-plus-style = "$dawn-pine" bold
	line-numbers-right-style = "$dawn-iris"
	line-numbers-zero-style = "$dawn-muted"
	minus-emph-style = syntax bold "$dawn-love/30"
	minus-style = syntax "$dawn-love/10"
	plus-emph-style = syntax bold "$dawn-pine/30"
	plus-style = syntax "$dawn-pine/10"
	whitespace-error-style = "$dawn-iris/10"
[delta "dark"]
	features = rose-pine
[delta "light"]
	features = rose-pine-dawn
